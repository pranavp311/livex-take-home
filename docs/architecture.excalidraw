      "groupIds": [],
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Card shape: {change_id, kind, title, attendee, old_start, new_start} in local time\nBrowser keeps chat + open cards and sends them with every request\nConfirm button disables after one click, so a card runs once\nCancel: 8 s undo toast in the browser, then /api/confirm; undo skips it\nSecrets from env: LIVEX_OPENROUTER_API_KEY, CAL_OAUTH_CLIENT_ID, CAL_OAUTH_CLIENT_SECRET",
      "roughness": 1,
      "roundness": null,
      "seed": 1338704292,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Card shape: {change_id, kind, title, attendee, old_start, new_start} in local time\nBrowser keeps chat + open cards and sends them with every request\nConfirm button disables after one click, so a card runs once\nCancel: 8 s undo toast in the browser, then /api/confirm; undo skips it\nSecrets from env: LIVEX_OPENROUTER_API_KEY, CAL_OAUTH_CLIENT_ID, CAL_OAUTH_CLIENT_SECRET",
      "textAlign": "left",
      "updated": 1793096972338,
      "version": 1,
      "versionNonce": 350482588,
      "verticalAlign": "top"
    },
